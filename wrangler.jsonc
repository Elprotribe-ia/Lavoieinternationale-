{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-voie-internationale",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-29",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-voie-internationale-db",
      "database_id": "3267a0d9-6dbd-44c5-89ca-f6c05c4afa7b",
      "migrations_dir": "migrations"
    }
  ]
}
